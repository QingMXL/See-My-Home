# Server-side only. Never expose this value to browser JavaScript.
ZOOWORK_API_KEY=

# Resolve from ZooWork rather than guessing.
ZOOWORK_MODEL_ID=

# The dedicated Home Style Agent, not the Home Layout Agent.
ZOOWORK_STYLE_AGENT_ID=

ZOOWORK_ALLOW_REMOTE_WRITE=false

# HTTPS origin where the hosted Agent can fetch uploaded room photos.
HOME_STYLE_PUBLIC_BASE_URL=

HOME_STYLE_TEST_PORT=4318
