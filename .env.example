# Shared server-side ZooWork credential. Never expose it with a VITE_ prefix.
ZOOWORK_API_KEY=

# Each Agent is independently addressable and versioned.
ZOOWORK_AGENT_ID=
ZOOWORK_STYLE_AGENT_ID=
ZOOWORK_FURNITURE_AGENT_ID=

# Vercel Blob creates this automatically when a private store is connected.
BLOB_READ_WRITE_TOKEN=
