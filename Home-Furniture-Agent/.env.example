# ZooWork organization API key. Server-side only.
# Create a new key in ZooWork, paste it into .env yourself, and never commit it.
ZOOWORK_API_KEY=

# Exact model id returned by the ZooWork listModels() call.
# Do not guess or copy a provider model name from another platform.
ZOOWORK_MODEL_ID=

# Filled after the Home Furniture Agent has been provisioned once.
ZOOWORK_FURNITURE_AGENT_ID=

# Remote ZooWork mutations stay disabled unless you explicitly approve a provisioning run.
ZOOWORK_ALLOW_REMOTE_WRITE=false

# Optional public HTTPS origin used when a hosted Agent must read locally uploaded
# sketches or inspiration images. Leave empty until local end-to-end testing.
HOME_FURNITURE_PUBLIC_BASE_URL=

# Local Home Furniture Runtime port. The Vite proxy will use this value by convention.
HOME_FURNITURE_TEST_PORT=4319

# Optional. The SDK already uses the production endpoint by default.
# ZOOWORK_BASE_URL=
