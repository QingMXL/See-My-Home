# Server-side only. Never expose this value to the browser.
ZOOWORK_API_KEY=zct_replace_with_a_new_unexposed_key

# Resolve the exact model identifier with `pnpm models`; do not guess it.
ZOOWORK_MODEL_ID=

# Written after private provisioning. Store it in your backend database in production.
ZOOWORK_AGENT_ID=

# Remote writes are refused unless this explicit guard is present.
ZOOWORK_ALLOW_REMOTE_WRITE=false

# Non-secret public HTTPS origin where the hosted Agent can read the uploaded
# source through /api/site/layout/source/:asset_id/:access_token.
# In production this is the deployed application backend. For local testing,
# use a temporary HTTPS tunnel to port 4317.
HOME_LAYOUT_PUBLIC_BASE_URL=

# Optional. The SDK production default is used when omitted.
# ZOOWORK_BASE_URL=
