{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://see-my-home.local/contracts/home-style-request-v1.json",
  "title": "Home Style Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "home_id",
    "source_asset_ref",
    "source_raster",
    "room_type",
    "style_id",
    "renovation_scope"
  ],
  "properties": {
    "contract_version": { "const": "home-style-v1" },
    "request_id": { "type": "string", "minLength": 1 },
    "home_id": { "type": "string", "minLength": 1 },
    "source_asset_ref": { "type": "string", "minLength": 1 },
    "source_raster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "aspect_ratio", "orientation", "designer_size"],
      "properties": {
        "width_px": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height_px": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "aspect_ratio": { "type": "string", "pattern": "^[1-9][0-9]{0,4}:[1-9][0-9]{0,4}$" },
        "orientation": { "enum": ["landscape", "portrait", "square"] },
        "designer_size": { "type": "string", "pattern": "^[1-9][0-9]{2,3}x[1-9][0-9]{2,3}$" }
      }
    },
    "style_reference_asset_ref": { "type": "string", "minLength": 1 },
    "room_type": {
      "enum": [
        "living_room",
        "primary_bedroom",
        "kitchen",
        "dining_room",
        "bathroom",
        "home_office",
        "other"
      ]
    },
    "style_id": { "const": "modern_east" },
    "style_profile": {
      "enum": ["quiet-poise", "urban-elegance", "sculptural-luxe", "warm-residence"]
    },
    "renovation_scope": {
      "enum": ["soft_furnishing_only", "finishes_and_furnishing", "limited_hard_finish"]
    },
    "user_preferences": {
      "type": "array",
      "items": { "type": "string", "maxLength": 240 },
      "maxItems": 12
    },
    "known_immutable_elements": {
      "type": "array",
      "items": { "type": "string", "maxLength": 160 },
      "maxItems": 40
    }
  }
}
