{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seemyhome.ai/schemas/room-map-response-1.0.json",
  "title": "See My Home — Room Map Parser Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "home_id",
    "status",
    "locale",
    "summary",
    "coordinate_space",
    "spaces",
    "boundaries",
    "openings",
    "questions",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "$ref": "#/$defs/id" },
    "home_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["completed", "needs_confirmation", "insufficient_input", "failed"] },
    "locale": { "enum": ["en-US", "zh-CN"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "coordinate_space": { "const": "image_normalized_0_1" },
    "spaces": {
      "type": "array",
      "minItems": 0,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/space" }
    },
    "boundaries": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/boundary" }
    },
    "openings": {
      "type": "array",
      "maxItems": 80,
      "items": { "$ref": "#/$defs/opening" }
    },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/question" }
    },
    "warnings": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "polygon": {
      "type": "array",
      "minItems": 3,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/point" }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "suggested_function", "suggested_function_code", "polygon", "centroid", "label_anchor", "confidence", "boundary_confidence", "planning_status", "exclusion_reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "suggested_function": { "type": "string", "minLength": 1, "maxLength": 100 },
        "suggested_function_code": {
          "enum": ["living_room", "family_room", "dining_room", "kitchen", "primary_bedroom", "guest_bedroom", "kids_room", "nursery", "home_office", "walk_in_closet", "bathroom", "powder_room", "laundry_room", "pantry", "mudroom", "entry", "balcony", "den", "storage", "garage", "home_theater", "fitness_room", "game_room", "other", "unknown"]
        },
        "polygon": { "$ref": "#/$defs/polygon" },
        "centroid": { "$ref": "#/$defs/point" },
        "label_anchor": { "$ref": "#/$defs/point" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "boundary_confidence": { "$ref": "#/$defs/confidence" },
        "planning_status": { "enum": ["included", "excluded", "uncertain"] },
        "exclusion_reason": {
          "oneOf": [
            { "enum": ["lightwell", "double_height", "void", "shaft", "outside_envelope", "other"] },
            { "type": "null" }
          ]
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "separates_space_ids", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["exterior", "wall", "partition", "unknown"] },
        "path": {
          "type": "array",
          "minItems": 2,
          "maxItems": 40,
          "items": { "$ref": "#/$defs/point" }
        },
        "separates_space_ids": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "position", "segment", "boundary_ref", "door_type", "swing", "connects_space_ids", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["door", "window", "open_passage", "unknown"] },
        "position": { "$ref": "#/$defs/point" },
        "segment": {
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/point" }],
              "minItems": 2,
              "maxItems": 2
            },
            { "type": "null" }
          ]
        },
        "boundary_ref": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "door_type": {
          "oneOf": [
            { "enum": ["entry", "interior", "sliding", "double", "unknown"] },
            { "type": "null" }
          ]
        },
        "swing": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["hinge_position", "opens_into_space_id", "direction"],
              "properties": {
                "hinge_position": { "oneOf": [{ "$ref": "#/$defs/point" }, { "type": "null" }] },
                "opens_into_space_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
                "direction": { "enum": ["clockwise", "counterclockwise", "sliding", "unknown"] }
              }
            },
            { "type": "null" }
          ]
        },
        "connects_space_ids": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "impact", "related_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "type": "string", "minLength": 1, "maxLength": 500 },
        "impact": { "enum": ["low", "medium", "high"] },
        "related_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
