{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "outputDirectory": "See-My-Home-Web/dist",
  "framework": "vite",
  "functions": {
    "api/home-layout.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "Home-Layout-Agent/skills/**/*.json"
    },
    "api/home-layout/**/*.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "Home-Layout-Agent/skills/**/*.json"
    },
    "api/home-style.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "Home-Style-Agent/contracts/*.json"
    },
    "api/home-style/**/*.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "Home-Style-Agent/contracts/*.json"
    },
    "api/home-furniture.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "Home-Furniture-Agent/{contracts,skills}/**/*"
    }
  },
  "rewrites": [
    { "source": "/api/home-furniture/:path*", "destination": "/api/home-furniture?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
