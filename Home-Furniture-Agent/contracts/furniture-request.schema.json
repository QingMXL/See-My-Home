{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://see-my-home.example/contracts/home-furniture-v1-request.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "project_id", "locale", "table_type", "source_priority", "design_controls"],
  "properties": {
    "contract_version": { "const": "home-furniture-v1" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "locale": { "enum": ["en-US", "zh-CN"] },
    "table_type": { "enum": ["dining_table", "coffee_table", "console_table", "side_table", "desk", "bedside_table", "nesting_tables", "bar_table", "other_table"] },
    "sketch_asset_ref": { "type": "string", "format": "uri", "maxLength": 4096 },
    "inspiration_asset_ref": { "type": "string", "format": "uri", "maxLength": 4096 },
    "description": { "type": "string", "maxLength": 4000 },
    "source_priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sketch", "inspiration"],
      "properties": {
        "sketch": { "type": "number", "minimum": 0, "maximum": 1 },
        "inspiration": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "design_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions_mm", "primary_material", "secondary_material", "top_shape", "edge_profile", "base_style", "finish", "storage"],
      "properties": {
        "dimensions_mm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "depth", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 250, "maximum": 5000 },
            "depth": { "type": "integer", "minimum": 200, "maximum": 2000 },
            "height": { "type": "integer", "minimum": 150, "maximum": 1500 }
          }
        },
        "primary_material": { "type": "string", "minLength": 1, "maxLength": 120 },
        "secondary_material": { "type": "string", "maxLength": 120 },
        "top_shape": { "enum": ["rectangular", "round", "oval", "square", "freeform"] },
        "edge_profile": { "type": "string", "minLength": 1, "maxLength": 120 },
        "base_style": { "type": "string", "minLength": 1, "maxLength": 120 },
        "finish": { "type": "string", "minLength": 1, "maxLength": 120 },
        "storage": { "type": "string", "maxLength": 240 },
        "component_notes": { "type": "string", "maxLength": 1000 }
      }
    }
  },
  "anyOf": [
    { "required": ["sketch_asset_ref"], "properties": { "sketch_asset_ref": {} } },
    { "required": ["inspiration_asset_ref"], "properties": { "inspiration_asset_ref": {} } },
    { "required": ["description"], "properties": { "description": { "type": "string", "minLength": 1 } } }
  ]
}
